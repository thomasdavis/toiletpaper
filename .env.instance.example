DATABASE_URL=postgres://toiletpaper:<password>@127.0.0.1:5432/toiletpaper
DONTOSRV_URL=http://127.0.0.1:7879
DONTO_DSN=postgres://donto:<password>@127.0.0.1:5432/donto
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_MODEL=glm-4.7
LLM_MAX_TOKENS=4096
LLM_API_KEY_FILE=/etc/donto/glm.key
# Rich graph extraction uses donto-agent after compact claim extraction.
# These defaults favor dense scientific-paper extraction and write JSONL
# observability under DONTO_AGENT_LOG_DIR.
DONTO_AGENT_BIN=/home/ajax/bin/donto-agent
DONTO_AGENT_PROVIDER=glm
DONTO_AGENT_MODEL=glm-4.7
DONTO_AGENT_KEY_FILE=/etc/donto/glm.key
DONTO_AGENT_CHUNK_CHARS=3500
DONTO_AGENT_CHUNK_OVERLAP_CHARS=700
DONTO_AGENT_MAX_PASSES=8
DONTO_AGENT_MAX_TOKENS=12000
DONTO_AGENT_LOG_DIR=/mnt/donto-data/toiletpaper/extractions
# Quality gate for rich extraction. A chunk that exits successfully but
# has partial provider output, no facts, sparse fact density, or weak
# anchor coverage is retried and logged as repaired/degraded.
DONTO_AGENT_RETRY_ATTEMPTS=4
DONTO_AGENT_RETRY_BASE_MS=60000
DONTO_AGENT_MIN_ANCHORED_RATIO=0.2
DONTO_AGENT_MIN_FACTS_PER_1K_CHARS=18
DONTO_AGENT_MIN_STATEMENTS_FOR_ANCHOR_CHECK=20
# "queue" means uploads/reingests insert paper_donto_ingest rows; the
# toiletpaper-donto-ingest-worker.service systemd unit performs extraction.
DONTO_INGEST_LAUNCHER=queue
# Optional: override the LLM lane used for simulation/classification.
# SIMULATOR_LLM_MODEL=glm-4.7
# SIMULATOR_LLM_API_KEY_FILE=/etc/donto/glm.key
UPLOADS_DIR=/mnt/donto-data/toiletpaper/uploads
SIMULATOR_WORKDIR=/mnt/donto-data/toiletpaper/simulations
# Supplemental source artifacts uploaded after the paper itself. If unset,
# defaults to $SIMULATOR_WORKDIR/paper-artifacts.
PAPER_ARTIFACTS_DIR=/mnt/donto-data/toiletpaper/simulations/paper-artifacts
# Per-bundle upload cap in bytes. Large paper artifact archives should be
# split into named bundles so staging/provenance remains inspectable.
PAPER_ARTIFACT_MAX_BYTES=262144000
TOILETPAPER_REPO_ROOT=/mnt/donto-data/workspace/toiletpaper
SIMULATION_GENERATION_ENABLED=1
NEXT_PUBLIC_SIMULATION_GENERATION_ENABLED=1
# Optional: use the local Codex CLI ChatGPT subscription for async
# full-paper replication jobs.
CODEX_SIMULATION_ENABLED=0
# "queue" means the web API only inserts simulation_jobs rows; the
# toiletpaper-codex-worker.service systemd unit runs Codex outside the web cgroup.
CODEX_JOB_LAUNCHER=queue
# Legacy per-unit builder cap; full-paper jobs use CODEX_FULL_PAPER_TIMEOUT_MS.
CODEX_SIMULATION_MAX_UNITS_PER_REQUEST=1
CODEX_SIMULATION_TIMEOUT_MS=240000
# Two hours by default; papers may legitimately take an hour or more.
CODEX_FULL_PAPER_TIMEOUT_MS=7200000
# Maximum current Donto paper-context statements staged into each Codex
# full-paper workdir as donto-statements.json.
CODEX_DONTO_STATEMENT_LIMIT=50000
# The service launches Codex inside a dedicated simulation workdir. Use
# workspace-write locally when bubblewrap is available; danger-full-access
# avoids bubblewrap failures under the current systemd deployment.
CODEX_SIMULATION_SANDBOX=danger-full-access
CODEX_BIN=codex
