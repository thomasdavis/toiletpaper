# SIMULATOR_LLM_API_KEY_FILE=/etc/donto/glm.key
UPLOADS_DIR=/mnt/donto-data/toiletpaper/uploads
SIMULATOR_WORKDIR=/mnt/donto-data/toiletpaper/simulations
