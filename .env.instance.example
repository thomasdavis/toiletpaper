DATABASE_URL=postgres://toiletpaper:<password>@127.0.0.1:5432/toiletpaper
DONTOSRV_URL=http://127.0.0.1:7879
DONTO_DSN=postgres://donto:<password>@127.0.0.1:5432/donto
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
